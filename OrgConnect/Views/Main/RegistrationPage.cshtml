@{
    ViewBag.Title = "Member Registration";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container page-section" ng-init="loadRegistrationDataFunc()">
    <div class="center-align">
        <h1 class="page-title">Member Registration</h1>
        <p class="page-subtitle">Register a member and save their account and membership in the database.</p>
    </div>

    <div class="card content-card registration-card">

        <div class="registration-card-header">
            <div class="registration-title-group">
                <span class="registration-header-icon">
                    <i class="material-icons">person_add</i>
                </span>
                <div>
                    <span class="registration-step">MEMBER INFORMATION</span>
                    <h5 class="form-heading">
                        {{ isEditing ? "Update Member in Table" : "Register New Member" }}
                    </h5>
                    <p class="registration-helper">Complete the member's account, contact, and organization details.</p>
                </div>
            </div>

        </div>

        <form name="registrationForm" class="registration-form-surface"
              ng-submit="isEditing ? updateFunc(registrationForm) : registrationFunc(registrationForm)"
              novalidate>
            @Html.AntiForgeryToken()
            <p class="blue-text text-darken-2" role="status" ng-show="isEditing">Editing a registered member. Save Changes will update the database.</p>
            <p class="red-text" role="alert" ng-show="serverErrors.form">{{serverErrors.form}}</p>
            <p class="grey-text text-darken-1">Classroom demonstration: use sample details and a dummy password. Account login is not implemented yet.</p>
            <p class="blue-text" ng-show="optionsLoading">Loading committees and positions...</p>
            <p class="red-text" role="alert" ng-show="optionsError">{{optionsError}}</p>
            <button type="button" class="btn-flat" ng-show="optionsError" ng-click="loadRegistrationDataFunc()">Retry loading options</button>

            <div class="row registration-form-grid">
                <div class="input-field col s12 m6 registration-input">
                    <i class="material-icons prefix">badge</i>
                    <input id="member_id"
                           name="memberID"
                           ng-class="{ 'invalid': serverErrors.memberID }"
                           type="text"
                           maxlength="8"
                           ng-model="memberID"
                           ng-model-options="{ allowInvalid: true }"
                           ng-change="memberID = (memberID || '').toUpperCase(); serverErrors.memberID = null"
                           ng-pattern="/^ORG-\d{4}$/"
                           ng-maxlength="8"
                           required />
                    <label for="member_id">Member ID (ORG-0001) <span class="required-mark" aria-hidden="true">*</span></label>

                    <span class="validation-message"
                          ng-show="(registrationForm.memberID.$dirty || registrationForm.memberID.$touched || registrationSubmitted) && registrationForm.memberID.$error.required">
                        Member ID is required.
                    </span>
                    <span class="validation-message"
                          ng-show="(registrationForm.memberID.$dirty || registrationForm.memberID.$touched || registrationSubmitted) && registrationForm.memberID.$error.pattern">
                        Use the format ORG-0001.
                    </span>
                    <span class="validation-message"
                          ng-show="registrationSubmitted && memberID && registrationForm.memberID.$valid && isDuplicateMemberID()">
                        Member ID already exists.
                    </span>
                    <span class="validation-message red-text" role="alert" ng-show="serverErrors.memberID">{{serverErrors.memberID}}</span>
                </div>

                <div class="input-field col s12 m6 registration-input">
                    <i class="material-icons prefix">account_circle</i>
                    <input id="username"
                           name="username"
                           ng-class="{ 'invalid': serverErrors.username }"
                           ng-change="serverErrors.username = null"
                           type="text"
                           maxlength="20"
                           ng-model="username"
                           ng-model-options="{ allowInvalid: true }"
                           ng-minlength="4"
                           ng-maxlength="20"
                           ng-pattern="/^[A-Za-z0-9._-]+$/"
                           required />
                    <label for="username">Username <span class="required-mark" aria-hidden="true">*</span></label>

                    <span class="validation-message"
                          ng-show="(registrationForm.username.$dirty || registrationForm.username.$touched || registrationSubmitted) && registrationForm.username.$error.required">
                        Username is required.
                    </span>
                    <span class="validation-message"
                          ng-show="(registrationForm.username.$dirty || registrationForm.username.$touched || registrationSubmitted) && (registrationForm.username.$error.minlength || registrationForm.username.$error.maxlength)">
                        Username must contain 4–20 characters.
                    </span>
                    <span class="validation-message"
                          ng-show="(registrationForm.username.$dirty || registrationForm.username.$touched || registrationSubmitted) && registrationForm.username.$error.pattern">
                        Use letters, numbers, periods, underscores, or hyphens only.
                    </span>
                    <span class="validation-message"
                          ng-show="registrationSubmitted && username && registrationForm.username.$valid && isDuplicateUsername()">
                        Username already exists.
                    </span>
                    <span class="validation-message red-text" role="alert" ng-show="serverErrors.username">{{serverErrors.username}}</span>
                </div>

                <div class="input-field col s12 m6 registration-input">
                    <i class="material-icons prefix">person</i>
                    <input id="first_name"
                           name="firstName"
                           ng-class="{ 'invalid': serverErrors.firstName }"
                           ng-change="serverErrors.firstName = null"
                           type="text"
                           maxlength="50"
                           ng-model="firstName"
                           ng-model-options="{ allowInvalid: true }"
                           ng-minlength="2"
                           ng-maxlength="50"
                           ng-pattern="/^[A-Za-z .'-]+$/"
                           required />
                    <label for="first_name">First Name <span class="required-mark" aria-hidden="true">*</span></label>

                    <span class="validation-message"
                          ng-show="(registrationForm.firstName.$dirty || registrationForm.firstName.$touched || registrationSubmitted) && registrationForm.firstName.$error.required">
                        First name is required.
                    </span>
                    <span class="validation-message"
                          ng-show="(registrationForm.firstName.$dirty || registrationForm.firstName.$touched || registrationSubmitted) && (registrationForm.firstName.$error.minlength || registrationForm.firstName.$error.maxlength)">
                        First name must contain 2–50 characters.
                    </span>
                    <span class="validation-message"
                          ng-show="(registrationForm.firstName.$dirty || registrationForm.firstName.$touched || registrationSubmitted) && registrationForm.firstName.$error.pattern">
                        Use letters, spaces, apostrophes, periods, and hyphens only.
                    </span>
                    <span class="validation-message red-text" role="alert" ng-show="serverErrors.firstName">{{serverErrors.firstName}}</span>
                </div>

                <div class="input-field col s12 m6 registration-input">
                    <i class="material-icons prefix">person</i>
                    <input id="last_name"
                           name="lastName"
                           ng-class="{ 'invalid': serverErrors.lastName }"
                           ng-change="serverErrors.lastName = null"
                           type="text"
                           maxlength="50"
                           ng-model="lastName"
                           ng-model-options="{ allowInvalid: true }"
                           ng-minlength="2"
                           ng-maxlength="50"
                           ng-pattern="/^[A-Za-z .'-]+$/"
                           required />
                    <label for="last_name">Last Name <span class="required-mark" aria-hidden="true">*</span></label>

                    <span class="validation-message"
                          ng-show="(registrationForm.lastName.$dirty || registrationForm.lastName.$touched || registrationSubmitted) && registrationForm.lastName.$error.required">
                        Last name is required.
                    </span>
                    <span class="validation-message"
                          ng-show="(registrationForm.lastName.$dirty || registrationForm.lastName.$touched || registrationSubmitted) && (registrationForm.lastName.$error.minlength || registrationForm.lastName.$error.maxlength)">
                        Last name must contain 2–50 characters.
                    </span>
                    <span class="validation-message"
                          ng-show="(registrationForm.lastName.$dirty || registrationForm.lastName.$touched || registrationSubmitted) && registrationForm.lastName.$error.pattern">
                        Use letters, spaces, apostrophes, periods, and hyphens only.
                    </span>
                    <span class="validation-message red-text" role="alert" ng-show="serverErrors.lastName">{{serverErrors.lastName}}</span>
                </div>

                <div class="input-field col s12 m6 registration-input">
                    <i class="material-icons prefix">email</i>
                    <input id="email"
                           name="email"
                           ng-class="{ 'invalid': serverErrors.email }"
                           ng-change="serverErrors.email = null"
                           type="email"
                           maxlength="100"
                           ng-model="email"
                           ng-model-options="{ allowInvalid: true }"
                           ng-pattern="emailPattern"
                           ng-maxlength="100"
                           ng-trim="true"
                           required />
                    <label for="email">Email Address <span class="required-mark" aria-hidden="true">*</span></label>

                    <span class="validation-message"
                          ng-show="(registrationForm.email.$dirty || registrationForm.email.$touched || registrationSubmitted) && registrationForm.email.$error.required">
                        Email address is required.
                    </span>
                    <span class="validation-message"
                          ng-show="(registrationForm.email.$dirty || registrationForm.email.$touched || registrationSubmitted) && !registrationForm.email.$error.required && (registrationForm.email.$error.email || registrationForm.email.$error.pattern)">
                        Enter a complete email address, such as name@example.com.
                    </span>
                    <span class="validation-message"
                          ng-show="registrationSubmitted && email && registrationForm.email.$valid && isDuplicateEmail()">
                        Email address already exists.
                    </span>
                    <span class="validation-message red-text" role="alert" ng-show="serverErrors.email">{{serverErrors.email}}</span>
                </div>

                <div class="input-field col s12 m6 registration-input">
                    <i class="material-icons prefix">phone</i>
                    <input id="contact_number"
                           name="contactNumber"
                           ng-class="{ 'invalid': serverErrors.contactNumber }"
                           type="tel"
                           inputmode="numeric"
                           maxlength="11"
                           ng-model="contactNumber"
                           ng-model-options="{ allowInvalid: true }"
                           ng-change="numbersOnlyFunc(); serverErrors.contactNumber = null"
                           ng-pattern="/^09\d{9}$/"
                           ng-maxlength="11"
                           required />
                    <label for="contact_number">Contact Number (09XXXXXXXXX) <span class="required-mark" aria-hidden="true">*</span></label>

                    <span class="validation-message"
                          ng-show="(registrationForm.contactNumber.$dirty || registrationForm.contactNumber.$touched || registrationSubmitted) && registrationForm.contactNumber.$error.required">
                        Contact number is required.
                    </span>
                    <span class="validation-message"
                          ng-show="(registrationForm.contactNumber.$dirty || registrationForm.contactNumber.$touched || registrationSubmitted) && registrationForm.contactNumber.$error.pattern">
                        Enter an 11-digit Philippine mobile number.
                    </span>
                    <span class="validation-message"
                          ng-show="registrationSubmitted && contactNumber && registrationForm.contactNumber.$valid && isDuplicateContactNumber()">
                        Contact number already exists.
                    </span>
                    <span class="validation-message red-text" role="alert" ng-show="serverErrors.contactNumber">{{serverErrors.contactNumber}}</span>
                </div>

                <div class="input-field col s12 m6 registration-input password-input">
                    <i class="material-icons prefix">lock</i>
                    <input id="password"
                           name="password"
                           ng-class="{ 'invalid': serverErrors.password }"
                           type="password"
                           maxlength="32"
                           ng-model="password"
                           ng-model-options="{ allowInvalid: true }"
                           ng-change="validatePasswordMatch(registrationForm); serverErrors.password = null; serverErrors.confirmPassword = null"
                           ng-minlength="8"
                           ng-maxlength="32"
                           ng-pattern="passwordPattern"
                           autocomplete="new-password"
                           required />
                    <label for="password">Password <span class="required-mark" aria-hidden="true">*</span></label>

                    <span class="validation-message"
                          ng-show="(registrationForm.password.$dirty || registrationForm.password.$touched || registrationSubmitted) && registrationForm.password.$error.required">
                        Password is required.
                    </span>
                    <span class="validation-message"
                          ng-show="(registrationForm.password.$dirty || registrationForm.password.$touched || registrationSubmitted) && !registrationForm.password.$error.required && (registrationForm.password.$error.minlength || registrationForm.password.$error.maxlength)">
                        Password must contain 8–32 characters.
                    </span>
                    <span class="validation-message"
                          ng-show="(registrationForm.password.$dirty || registrationForm.password.$touched || registrationSubmitted) && !registrationForm.password.$error.required && !registrationForm.password.$error.minlength && !registrationForm.password.$error.maxlength && registrationForm.password.$error.pattern">
                        Include uppercase, lowercase, number, and special character.
                    </span>
                    <span class="validation-message red-text" role="alert" ng-show="serverErrors.password">{{serverErrors.password}}</span>
                </div>

                <div class="input-field col s12 m6 registration-input password-input">
                    <i class="material-icons prefix">lock_outline</i>
                    <input id="confirm_password"
                           name="confirmPassword"
                           ng-class="{ 'invalid': serverErrors.confirmPassword }"
                           type="password"
                           maxlength="32"
                           ng-model="confirmPassword"
                           ng-model-options="{ allowInvalid: true }"
                           ng-change="validatePasswordMatch(registrationForm); serverErrors.confirmPassword = null"
                           autocomplete="new-password"
                           required />
                    <label for="confirm_password">Confirm Password <span class="required-mark" aria-hidden="true">*</span></label>

                    <span class="validation-message"
                          ng-show="(registrationForm.confirmPassword.$dirty || registrationForm.confirmPassword.$touched || registrationSubmitted) && registrationForm.confirmPassword.$error.required">
                        Please confirm the password.
                    </span>
                    <span class="validation-message"
                          ng-show="(registrationForm.confirmPassword.$dirty || registrationForm.confirmPassword.$touched || registrationSubmitted) && !registrationForm.confirmPassword.$error.required && registrationForm.confirmPassword.$error.passwordMatch">
                        Passwords do not match.
                    </span>
                    <span class="validation-message red-text" role="alert" ng-show="serverErrors.confirmPassword">{{serverErrors.confirmPassword}}</span>
                </div>

                <div class="col s12 m6 select-field registration-select">
                    <label for="committee">Group / Committee <span class="required-mark" aria-hidden="true">*</span></label>
                    <select id="committee"
                            name="committee"
                            ng-class="{ 'invalid': serverErrors.committee }"
                            class="browser-default"
                            ng-model="committee"
                            ng-change="committeeChangedFunc(); serverErrors.committee = null"
                            required>
                        <option value="">Select a group or committee</option>
                        <option ng-repeat="item in committeeList" value="{{item}}">
                            {{item}}
                        </option>
                    </select>

                    <span class="validation-message select-error"
                          ng-show="(registrationForm.committee.$dirty || registrationForm.committee.$touched || registrationSubmitted) && registrationForm.committee.$error.required">
                        Group or committee is required.
                    </span>
                    <span class="validation-message red-text" role="alert" ng-show="serverErrors.committee">{{serverErrors.committee}}</span>
                </div>

                <div class="col s12 m6 select-field registration-select">
                    <label for="position">Role <span class="required-mark" aria-hidden="true">*</span></label>
                    <select id="position"
                            name="position"
                            ng-class="{ 'invalid': serverErrors.position }"
                            ng-change="serverErrors.position = null"
                            class="browser-default"
                            ng-model="position"
                            required>
                        <option value="">Select a role</option>
                        <option ng-repeat="item in positionList" value="{{item}}">
                            {{item}}
                        </option>
                    </select>

                    <span class="validation-message select-error"
                          ng-show="(registrationForm.position.$dirty || registrationForm.position.$touched || registrationSubmitted) && registrationForm.position.$error.required">
                        Role is required.
                    </span>
                    <span class="validation-message red-text" role="alert" ng-show="serverErrors.position">{{serverErrors.position}}</span>
                </div>
            </div>

            <div class="form-button-row">
                <div>
                    <button type="submit" ng-disabled="isSaving || isDeleting || optionsLoading || optionsError"
                            class="btn-large waves-effect waves-light form-button primary-form-button">
                        <i class="material-icons">{{isEditing ? "save" : "person_add"}}</i>
                        <span>{{isEditing ? "Save Changes" : "Register Member"}}</span>
                    </button>
                </div>

                <div>
                    <button type="button"
                            class="btn-large waves-effect registration-clear-button form-button"
                            ng-disabled="isSaving || isDeleting" ng-click="clearRegistrationFunc(registrationForm)">
                        <i class="material-icons">restart_alt</i>
                        <span>{{isEditing ? "Cancel Edit" : "Clear Fields"}}</span>
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div class="card content-card member-table-card">
        <div class="table-heading-row">
            <h5 class="form-heading">Registration Table — This Visit</h5>
            <span class="member-count">Total: {{userarray.length}}</span>
        </div>

        <div class="empty-table-message" ng-show="userarray.length === 0">
            <i class="material-icons">group_off</i>
            <p>No registrations have been saved during this visit.</p>
        </div>

        <p class="grey-text text-darken-1">Register, Save Changes, and Delete save changes to MySQL. This table shows members registered during this visit; refreshing clears the display but does not undo saved changes. Only records created in the current session can be changed. Account login is for a later stage.</p>
        <div class="responsive-table-container" ng-show="userarray.length > 0">
            <table class="highlight member-table">
                <thead>
                    <tr>
                        <th>Member ID</th>
                        <th>Full Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Contact Number</th>
                        <th>Group / Committee</th>
                        <th>Role</th>
                        <th>Actions</th>

                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="user in userarray track by $index">
                        <td data-label="Member ID">{{user.MemberID}}</td>
                        <td data-label="Full Name">{{user.FName}} {{user.LName}}</td>
                        <td data-label="Username">@@{{user.Username}}</td>
                        <td data-label="Email">{{user.Email}}</td>
                        <td data-label="Contact Number">{{user.ContactNumber}}</td>
                        <td data-label="Group / Committee">{{user.Committee}}</td>
                        <td data-label="Role">{{user.Position}}</td>
                        <td data-label="Actions" class="action-column">
                            <button type="button" class="btn-small waves-effect waves-light blue" title="Edit member" aria-label="Edit member"
                                    ng-disabled="isSaving || isDeleting || optionsLoading" ng-click="editFunc($index, registrationForm)">
                                <i class="material-icons" aria-hidden="true">edit</i>
                            </button>
                            <button type="button" class="btn-small waves-effect waves-light red darken-2" title="Delete from database" aria-label="Delete member from database"
                                    ng-disabled="isSaving || isDeleting" ng-click="deleteFunc($index)">
                                <i class="material-icons" aria-hidden="true">delete</i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>


