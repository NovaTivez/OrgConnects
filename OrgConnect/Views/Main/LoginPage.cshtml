@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<section class="login-page">
    <div class="login-shell">
        <div class="login-visual">
            <div class="visual-circle circle-one"></div>
            <div class="visual-circle circle-two"></div>
            <div class="visual-grid"></div>

            <div class="login-visual-content">
                <span class="eyebrow light-eyebrow">WELCOME TO ORGCONNECT</span>
                <h1>Where every member stays connected.</h1>
                <p>Organize member information, committees, and roles through one simple student organization system.</p>

                <div class="network-illustration">
                    <div class="network-line line-one"></div>
                    <div class="network-line line-two"></div>
                    <div class="network-person person-one"><i class="material-icons">person</i></div>
                    <div class="network-person person-two"><i class="material-icons">person</i></div>
                    <div class="network-person person-three"><i class="material-icons">person</i></div>
                    <div class="network-center"><i class="material-icons">hub</i></div>
                </div>
            </div>
        </div>

        <div class="login-panel">
            <div class="login-form-wrap">
                <div class="login-panel-header">
                    <a href="@Url.Action("Index", "Main")" class="login-mini-brand">
                        <span class="brand-mark"><i class="material-icons">hub</i></span>
                        <span>OrgConnect</span>
                    </a>
                    <span class="login-portal-badge">Member Portal</span>
                </div>

                <div class="login-heading">
                    <h2>Welcome back</h2>
                    <p class="login-subtitle">Enter your account details to continue.</p>
                </div>

                <form name="loginForm" ng-submit="loginFunc(loginForm)" novalidate>
                    <div class="input-field login-input">
                        <i class="material-icons prefix">person_outline</i>
                        <input id="login_username" name="loginUsername" type="text" maxlength="20"
                               ng-model="loginUsername" ng-minlength="4" ng-maxlength="20" required />
                        <label for="login_username">Username <span class="required-mark" aria-hidden="true">*</span></label>
                        <span class="validation-message"
                              ng-show="(loginForm.loginUsername.$dirty || loginForm.loginUsername.$touched || loginSubmitted) && loginForm.loginUsername.$error.required">Username is required.</span>
                        <span class="validation-message"
                              ng-show="(loginForm.loginUsername.$dirty || loginForm.loginUsername.$touched || loginSubmitted) && (loginForm.loginUsername.$error.minlength || loginForm.loginUsername.$error.maxlength)">Use 4 to 20 characters.</span>
                    </div>

                    <div class="input-field login-input">
                        <i class="material-icons prefix">lock_outline</i>
                        <input id="login_password" name="loginPassword" type="password" maxlength="32"
                               ng-model="loginPassword" ng-minlength="8" ng-maxlength="32" required />
                        <label for="login_password">Password <span class="required-mark" aria-hidden="true">*</span></label>
                        <span class="validation-message"
                              ng-show="(loginForm.loginPassword.$dirty || loginForm.loginPassword.$touched || loginSubmitted) && loginForm.loginPassword.$error.required">Password is required.</span>
                        <span class="validation-message"
                              ng-show="(loginForm.loginPassword.$dirty || loginForm.loginPassword.$touched || loginSubmitted) && (loginForm.loginPassword.$error.minlength || loginForm.loginPassword.$error.maxlength)">Password must contain 8 to 32 characters.</span>
                    </div>

                    <div class="login-actions">
                        <button type="submit" class="btn-large waves-effect waves-light login-primary-button">
                            <i class="material-icons">login</i>
                            <span>Login</span>
                        </button>

                        <button type="button" class="waves-effect login-clear-button"
                                ng-click="clearLoginFunc(loginForm)">
                            <i class="material-icons">refresh</i>
                            <span>Clear fields</span>
                        </button>
                    </div>

                    <div class="registration-link">
                        <span>Not registered yet?</span>
                        <a href="" ng-click="registrationRedirectFunc()">Create a member record</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
