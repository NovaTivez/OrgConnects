@{
    ViewBag.Title = "Contact";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<section class="inner-hero">
    <div class="container center-align">
        <span class="eyebrow light-eyebrow">GET IN TOUCH</span>
        <h1>We are here to help</h1>
        <p>Contact the OrgConnect organization office for membership assistance.</p>
    </div>
</section>

<section class="section-space contact-section">
    <div class="container">
        <div class="row">
            <div class="col s12 l5">
                <span class="eyebrow">CONTACT DETAILS</span>
                <h2>Let us connect</h2>
                <p class="contact-intro">Reach the organization office using any of the details below.</p>

                <div class="contact-list">
                    <div class="contact-item"><span><i class="material-icons">person</i></span><div><small>Contact person</small><strong>Organization Administrator</strong></div></div>
                    <div class="contact-item"><span><i class="material-icons">email</i></span><div><small>Email address</small><strong>orgconnect@email.com</strong></div></div>
                    <div class="contact-item"><span><i class="material-icons">phone</i></span><div><small>Contact number</small><strong>0912 345 6789</strong></div></div>
                    <div class="contact-item"><span><i class="material-icons">location_on</i></span><div><small>Office address</small><strong>University Organization Office, Manila</strong></div></div>
                </div>
            </div>

            <div class="col s12 l6 offset-l1">
                <div class="office-panel">
                    <div class="office-panel-top">
                        <span class="tile-icon gold-icon"><i class="material-icons">business</i></span>
                        <div><span class="eyebrow">ORGANIZATION OFFICE</span><h4>Visit during office hours</h4></div>
                    </div>
                    <p>Our office assists members with registration, committee information, organization activities, and general concerns.</p>
                    <div class="office-hours">
                        <div><i class="material-icons">calendar_month</i><span>Monday to Friday</span></div>
                        <div><i class="material-icons">schedule</i><span>8:00 AM - 5:00 PM</span></div>
                    </div>
                    <a href="mailto:orgconnect@email.com" class="btn-large waves-effect primary-button">Send an email <i class="material-icons right">send</i></a>
                </div>
            </div>
        </div>
    </div>
</section>
